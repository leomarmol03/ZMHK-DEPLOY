# Copia a config.env SOLO para uso local. Nunca publiques credenciales.
BOT_TOKEN=
OWNER_ID=
# Otros usuarios autorizados, separados por comas (opcional).
AUTHORIZED_USERS=
DOWNLOAD_DIR=downloads
# Límite por descarga (MiB). Telegram público admite hasta 50 MB por envío.
MAX_DOWNLOAD_MB=45
TASK_TIMEOUT=1800
# Opcional: rclone instalado y configurado, p. ej. drive:Bot
RCLONE_DESTINATION=
RCLONE_CONFIG=
